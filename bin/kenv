#!/usr/bin/env bash
# kenv - conda-like env manager on top of uv (pip/PyPI only)
set -euo pipefail
KENV_VERSION=0.1.1
KENV_HOME="${KENV_HOME:-$HOME/.kenv}"; ENVS="$KENV_HOME/envs"; mkdir -p "$ENVS"
die(){ echo "kenv: $*" >&2; exit 1; }
valid(){ [[ "${1:-}" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]] || die "invalid env name '${1:-}' (allowed: letters, digits, . _ -; must not start with . or -)"; }
envp(){ valid "${1:-}"; echo "$ENVS/$1"; }
pyof(){ echo "$(envp "$1")/bin/python"; }
need(){ [[ -x "$(pyof "$1")" ]] || die "env '$1' not found (see: kenv list)"; }
pyver(){ "$(pyof "$1")" -c 'import sys;print("%d.%d.%d"%sys.version_info[:3])'; }
command -v uv >/dev/null || die "uv not found in PATH (install: curl -LsSf https://astral.sh/uv/install.sh | sh)"
target(){
  if [[ -n "$NAME" ]]; then echo "$NAME"
  elif [[ -n "${VIRTUAL_ENV:-}" && "$(dirname "$VIRTUAL_ENV")" == "$ENVS" ]]; then basename "$VIRTUAL_ENV"
  else die "no target env: use -n NAME or activate one"; fi; }
usage(){ cat <<U
kenv $KENV_VERSION - conda-like envs on uv (pip/PyPI only)
kenv create NAME [--python 3.x] [pkgs...]   create env (installs Python via uv if needed)
kenv activate NAME | deactivate              (needs: source kenv.sh)
kenv list                                    list envs (* = active)
kenv install [-n NAME] pkgs...|-r file       uv pip install
kenv uninstall [-n NAME] pkgs...             uv pip uninstall
kenv freeze [-n NAME]                        pinned packages
kenv export [-n NAME] [-o FILE] [--lock]     requirements.txt (or hashed lock)
kenv import NAME FILE [--python 3.x]         create env from requirements/lock (exact sync)
kenv clone SRC DST                           clone env (same python, same pins)
kenv kernel [-n NAME]                        register Jupyter kernel "kenv-NAME"
kenv audit [-n NAME]                         pip-audit scan (exit 1 if vulnerable)
kenv remove NAME                             delete env (+ its kernel)
kenv python list|install VER                 manage Python builds (uv)
U
}
CREATING=""
cleanup(){ if [[ -n "$CREATING" ]]; then rm -rf "$CREATING"; fi; }
trap cleanup EXIT
mk(){ # name ver ; rolls back on later failure
  local p; p=$(envp "$1"); [[ -e "$p" ]] && die "env '$1' already exists"
  [[ -n "$2" ]] || die "--python needs a version"
  uv python install "$2" >/dev/null 2>&1 || true
  CREATING="$p"
  uv venv -q "$p" --python "$2" --prompt "$1" || die "could not create env with Python '$2'"
}
done_mk(){ CREATING=""; }
cmd="${1:-help}"; shift || true
NAME=""; args=()
while [[ $# -gt 0 ]]; do case "$1" in
  -n|--name) [[ $# -ge 2 ]] || die "$1 needs a value"; NAME="$2"; valid "$NAME"; shift 2;;
  *) args+=("$1"); shift;; esac; done
set -- "${args[@]+"${args[@]}"}"
case "$cmd" in
 create)
  [[ $# -ge 1 ]] || die "usage: kenv create NAME [--python 3.x] [pkgs...]"
  n="$1"; shift; valid "$n"; ver="3.12"; pk=()
  while [[ $# -gt 0 ]]; do case "$1" in
    --python|-p) [[ $# -ge 2 ]] || die "--python needs a version"; ver="$2"; shift 2;;
    *) pk+=("$1"); shift;; esac; done
  mk "$n" "$ver"
  if [[ ${#pk[@]} -gt 0 ]]; then uv pip install -q --python "$(pyof "$n")" "${pk[@]}" || die "package install failed; env '$n' rolled back"; fi
  done_mk; echo "created '$n' (Python $(pyver "$n")) -> $(envp "$n")";;
 list|ls|env)
  printf "%-20s %-10s %s\n" NAME PYTHON PATH
  for d in "$ENVS"/*/; do [[ -x "$d/bin/python" ]] || continue; n=$(basename "$d")
   m=" "; [[ "${VIRTUAL_ENV:-}" == "${d%/}" ]] && m="*"
   printf "%-20s %-10s %s\n" "$m$n" "$("$d/bin/python" -c 'import sys;print("%d.%d.%d"%sys.version_info[:3])')" "${d%/}"; done;;
 install|add)  [[ $# -ge 1 ]] || die "nothing to install"; t=$(target); need "$t"; uv pip install --python "$(pyof "$t")" "$@";;
 uninstall)    [[ $# -ge 1 ]] || die "nothing to uninstall"; t=$(target); need "$t"; uv pip uninstall --python "$(pyof "$t")" "$@";;
 freeze) t=$(target); need "$t"; uv pip freeze -q --python "$(pyof "$t")";;
 export)
  t=$(target); need "$t"; out=""; lock=0
  while [[ $# -gt 0 ]]; do case "$1" in
    -o) [[ $# -ge 2 ]] || die "-o needs a file"; out="$2"; shift 2;;
    --lock) lock=1; shift;; *) die "unknown option: $1";; esac; done
  tmp=$(mktemp); { echo "# kenv-env: $t"; echo "# python: $(pyver "$t")"; } >"$tmp"
  if [[ $lock = 1 ]]; then
   uv pip freeze -q --python "$(pyof "$t")" > "$tmp.in"
   uv pip compile -q "$tmp.in" --python-version "$(pyver "$t" | cut -d. -f1,2)" --generate-hashes --no-header >> "$tmp" || { rm -f "$tmp" "$tmp.in"; die "lock failed"; }
   rm -f "$tmp.in"
  else uv pip freeze -q --python "$(pyof "$t")" >> "$tmp"; fi
  if [[ -n "$out" ]]; then mv "$tmp" "$out"; echo "exported '$t' -> $out"; else cat "$tmp"; rm -f "$tmp"; fi;;
 import)
  [[ $# -ge 2 ]] || die "usage: kenv import NAME FILE [--python 3.x]"
  n="$1"; f="$2"; shift 2; valid "$n"; [[ -f "$f" ]] || die "file not found: $f"
  ver=$(sed -n 's/^# python: //p' "$f" | head -1); ver="${ver:-3.12}"
  if [[ "${1:-}" == --python ]]; then [[ $# -ge 2 ]] || die "--python needs a version"; ver="$2"; fi
  mk "$n" "$ver"; uv pip sync -q --python "$(pyof "$n")" "$f" || die "sync failed; env '$n' rolled back"
  done_mk; echo "imported '$n' (Python $(pyver "$n")) from $f";;
 clone)
  [[ $# -ge 2 ]] || die "usage: kenv clone SRC DST"
  need "$1"; tmp=$(mktemp); uv pip freeze -q --python "$(pyof "$1")" > "$tmp"
  mk "$2" "$(pyver "$1")"; uv pip sync -q --python "$(pyof "$2")" "$tmp" || { rm -f "$tmp"; die "clone failed; rolled back"; }
  rm -f "$tmp"; done_mk; echo "cloned '$1' -> '$2'";;
 kernel)
  t=$(target); need "$t"; py="$(pyof "$t")"
  uv pip install -q --python "$py" ipykernel
  "$py" -m ipykernel install --user --name "kenv-$t" --display-name "Python $(pyver "$t") (kenv: $t)";;
 audit)
  t=$(target); need "$t"; tmp=$(mktemp); uv pip freeze -q --python "$(pyof "$t")" > "$tmp"
  rc=0; uvx -q pip-audit -r "$tmp" --no-deps --disable-pip --progress-spinner off || rc=$?; rm -f "$tmp"; exit $rc;;
 remove|rm)
  [[ $# -ge 1 ]] || die "usage: kenv remove NAME"
  need "$1"; [[ "${VIRTUAL_ENV:-}" == "$(envp "$1")" ]] && die "env '$1' is active; run 'kenv deactivate' first"
  rm -rf "$(envp "$1")"; k="${XDG_DATA_HOME:-$HOME/.local/share}/jupyter/kernels/kenv-$1"; rm -rf "$k"
  echo "removed '$1'";;
 python) uv python "$@";;
 prefix) [[ $# -ge 1 ]] || die "usage: kenv prefix NAME"; need "$1"; envp "$1";;
 activate|deactivate) die "activate/deactivate are shell functions: source kenv.sh first";;
 version|--version|-V) echo "kenv $KENV_VERSION";;
 help|-h|--help) usage;;
 *) usage >&2; die "unknown command: $cmd";;
esac
